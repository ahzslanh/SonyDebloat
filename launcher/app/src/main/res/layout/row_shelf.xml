<?xml version="1.0" encoding="utf-8"?>
<!-- One shelf row inside the home grid: a heading and a horizontal rail of vertical posters.
     The rail's height is set in code from the poster size, so it measures correctly inside the
     grid (a nested RecyclerView must not be left to wrap_content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/shelfTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="60dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.01" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelfRail"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
