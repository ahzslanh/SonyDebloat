<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the clock and pills readable over a bright poster without darkening the middle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#B3000000"
        android:centerColor="#26000000"
        android:endColor="#A6000000"
        android:type="linear" />
</shape>
