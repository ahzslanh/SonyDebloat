tools/venv/
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# ...except the launcher's restore points: they are the way back to a known-good
# build, so sony-debloat/apk-backups/ is kept in the repo.
!sony-debloat/apk-backups/*.apk

# The archived first launcher skeleton (superseded by launcher/): keep its sources,
# leave its build output out.
archive/**/build/
archive/**/.gradle/
archive/**/local.properties
